@@ -0,0 +1,40 @@
+//! Group-based prover cost breakdown: what share of a Groth16 proof is multi-scalar
+//! multiplication (the analogue of hashing in a hash-based prover).
+//! Env: CIRCUIT=sha256|synthetic SHA_BLOCKS=1 LOG_N=16 REPS=3 OUT=path.csv
+mod common;
+use common::*;
+use ark_groth16::{dynark_prover::prover_stats, Groth16};
+use ark_relations::r1cs::SynthesisError;
+use ark_std::rand::SeedableRng;
+use rand_chacha::ChaCha20Rng;
+use std::{io::Write, time::Instant};
+
+fn main() -> Result<(), SynthesisError> {
+    let circuit: String = env("CIRCUIT", "sha256".to_string());
+    let log_n: usize = env("LOG_N", 16);
+    let blocks: usize = env("SHA_BLOCKS", 1);
+    let reps: usize = env("REPS", 3);
+    let out: String = env("OUT", "results/groth16_msm_share.csv".to_string());
+    let threads = std::env::var("RAYON_NUM_THREADS").unwrap_or_else(|_| "all".into());
+    let mut rng = ChaCha20Rng::seed_from_u64(42);
+    let (matrices, instance, witness, _) = if circuit == "sha256" { sha256_circuit(blocks, tag_of(0)) } else { synthetic_circuit(log_n, tag_of(0), &mut rng) };
+    let n = matrices.num_constraints; let nv = matrices.num_instance_variables + matrices.num_witness_variables;
+    let (pk, _vk, _domain) = Groth16::<E>::groth16_setup_dynark(matrices.clone(), &mut rng)?;
+    // warm-up
+    let _ = Groth16::<E>::prove_dynark(&pk, &matrices, &instance, &witness, &mut rng)?;
+    let new = !std::path::Path::new(&out).exists();
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(&out).unwrap();
+    if new { writeln!(f, "circuit,constraints,variables,threads,rep,t_total_s,{},msm_s,msm_share", prover_stats::PHASES.iter().map(|p| format!("{p}_s")).collect::<Vec<_>>().join(",")).unwrap(); }
+    for rep in 1..=reps {
+        let s0 = prover_stats::snapshot();
+        let t = Instant::now();
+        let _ = Groth16::<E>::prove_dynark(&pk, &matrices, &instance, &witness, &mut rng)?;
+        let total = t.elapsed().as_secs_f64();
+        let d = prover_stats::diff(&prover_stats::snapshot(), &s0);
+        let secs: Vec<f64> = d.iter().map(|&x| x as f64 * 1e-9).collect();
+        let msm: f64 = secs[3..8].iter().sum();
+        eprintln!("GROTH16_PHASES: circuit={circuit} n={n} threads={threads} total={total:.4}s msm={msm:.4}s ({:.1}%) {}", 100.0 * msm / total, prover_stats::render(&d));
+        writeln!(f, "{circuit},{n},{nv},{threads},{rep},{total:.5},{},{msm:.5},{:.4}", secs.iter().map(|x| format!("{x:.5}")).collect::<Vec<_>>().join(","), msm / total).unwrap();
+    }
+    Ok(())
+}
diff --git a/ark-groth16/examples/tagged_bench.rs b/ark-groth16/examples/tagged_bench.rs
new file mode 100644
index 0000000..ff717b8
--- /dev/null
+++ b/ark-groth16/examples/tagged_bench.rs
@@ -0,0 +1,102 @@
+//! Toy tagged Groth16: the tag is public input #1 bound by one constraint `tag * 0 = 0`.
+//! Measures how a batch prover amortizes across T tags with Dynark's proof update.
+//!
+//! Env: CIRCUIT=sha256|synthetic  LOG_N=16 (synthetic rows)  SHA_BLOCKS=1 (preimage 64B blocks)
+//!      TAGS="2 4 16 64 256"  REPS=3  FULL_PREP=0|1  CHECK=1 (compare targeted vs full at small n)
+//!      OUT=path.csv
+mod common;
+use common::*;
+use ark_groth16::{prepare_verifying_key, Groth16};
+use ark_relations::r1cs::SynthesisError;
+use ark_std::rand::SeedableRng;
+use rand_chacha::ChaCha20Rng;
+use std::{io::Write, time::Instant};
+
+fn main() -> Result<(), SynthesisError> {
+    let circuit: String = env("CIRCUIT", "sha256".to_string());
+    let log_n: usize = env("LOG_N", 16);
+    let blocks: usize = env("SHA_BLOCKS", 1);
+    let tags: Vec<usize> = std::env::var("TAGS").unwrap_or("2 4 16 64 256".into()).split_whitespace().map(|s| s.parse().unwrap()).collect();
+    let reps: usize = env("REPS", 3);
+    let full_prep: bool = env::<u32>("FULL_PREP", 1) == 1;
+    let check: bool = env::<u32>("CHECK", 0) == 1;
+    let out: String = env("OUT", "results/dynark_tagged.csv".to_string());
+    let mut rng = ChaCha20Rng::seed_from_u64(42);
+
+    let t0 = tag_of(0);
+    let (matrices, instance, witness, tag_row) = if circuit == "sha256" { sha256_circuit(blocks, t0) } else { synthetic_circuit(log_n, t0, &mut rng) };
+    let n = matrices.num_constraints; let nv = matrices.num_instance_variables + matrices.num_witness_variables;
+    assert_eq!(instance[TAG_VAR], t0);
+    eprintln!("circuit={circuit} constraints(padded)={n} variables={nv} tag_row={tag_row}");
+
+    let t = Instant::now();
+    let (pk, vk, domain) = Groth16::<E>::groth16_setup_dynark(matrices.clone(), &mut rng)?;
+    let t_setup = t.elapsed().as_secs_f64();
+    let t = Instant::now();
+    let uk = Groth16::<E>::generate_updating_keys(&matrices, &domain, &pk)?;
+    let t_uk = t.elapsed().as_secs_f64();
+    let pvk = prepare_verifying_key(&vk);
+    eprintln!("setup {t_setup:.2}s, updating key {t_uk:.2}s");
+
+    // Fresh proofs (the honest per-tag cost), median of reps.
+    let mut fresh = Vec::new();
+    let mut proof0 = None; let mut cache0 = None;
+    for _ in 0..reps {
+        let t = Instant::now();
+        let (p, c) = Groth16::<E>::prove_dynark(&pk, &matrices, &instance, &witness, &mut rng)?;
+        fresh.push(t.elapsed().as_secs_f64());
+        proof0 = Some(p); cache0 = Some(c);
+    }
+    fresh.sort_by(|a, b| a.partial_cmp(b).unwrap()); let t_fresh = fresh[reps / 2];
+    let proof0 = proof0.unwrap(); let mut cache = cache0.unwrap();
+    assert!(Groth16::<E>::verify_dynark(&pvk, &proof0, &instance)?);
+    let mut other = instance.clone(); other[TAG_VAR] = tag_of(999);
+    assert!(!Groth16::<E>::verify_dynark(&pvk, &proof0, &other)?, "proof verified under a different tag: tag not bound");
+    eprintln!("fresh proof {t_fresh:.3}s (verifies under its tag, rejected under another)");
+
+    // Preprocessing: targeted (one row) and optionally Dynark's full version.
+    let t = Instant::now();
+    Groth16::<E>::process_dynark_rows(&uk, &matrices, &instance, &witness, &[tag_row], &mut cache)?;
+    let t_prep_targeted = t.elapsed().as_secs_f64();
+    let (qa_t, qb_t) = (cache.q_a[tag_row], cache.q_b[tag_row]);
+    let mut t_prep_full = f64::NAN;
+    if full_prep {
+        let mut cache_full = cache.clone();
+        let t = Instant::now();
+        Groth16::<E>::process_dynark(&uk, &matrices, &instance, &witness, &mut cache_full)?;
+        t_prep_full = t.elapsed().as_secs_f64();
+        if check { assert_eq!(cache_full.q_a[tag_row], qa_t); assert_eq!(cache_full.q_b[tag_row], qb_t); eprintln!("CHECK ok: targeted projection terms equal full preprocessing at the tag row"); }
+    }
+    eprintln!("preprocessing: targeted {t_prep_targeted:.3}s, full {t_prep_full:.3}s");
+
+    // Updates: one per additional tag, each verified under its own tag and rejected under tag 0.
+    let max_t = *tags.iter().max().unwrap();
+    let mut t_updates = Vec::with_capacity(max_t);
+    let mut t_verify = 0.0;
+    for k in 1..max_t {
+        let tk = tag_of(k as u64);
+        let t = Instant::now();
+        let pk_proof = Groth16::<E>::update_dynark_with_rng(&uk, &matrices, &[(TAG_VAR, tk - t0)], &[], &cache, &mut rng)?;
+        t_updates.push(t.elapsed().as_secs_f64());
+        let mut inst_k = instance.clone(); inst_k[TAG_VAR] = tk;
+        let t = Instant::now();
+        assert!(Groth16::<E>::verify_dynark(&pvk, &pk_proof, &inst_k)?, "updated proof for tag {k} failed to verify");
+        t_verify += t.elapsed().as_secs_f64();
+        if k < 8 { assert!(!Groth16::<E>::verify_dynark(&pvk, &pk_proof, &instance)?, "updated proof verified under tag 0"); }
+    }
+    let t_update_avg = t_updates.iter().sum::<f64>() / t_updates.len() as f64;
+    eprintln!("updates: avg {:.2} ms over {} tags (all verified under own tag; first 7 rejected under tag 0), verify avg {:.2} ms", t_update_avg * 1e3, t_updates.len(), t_verify / t_updates.len() as f64 * 1e3);
+
+    let new = !std::path::Path::new(&out).exists();
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(&out).unwrap();
+    if new { writeln!(f, "circuit,constraints,variables,T,t_setup_s,t_uk_s,t_fresh_s,t_prep_targeted_s,t_prep_full_s,t_update_ms,honest_T_s,batch_targeted_s,batch_full_s,ratio_targeted,ratio_full").unwrap(); }
+    for &tt in &tags {
+        let upd: f64 = t_updates[..tt - 1].iter().sum();
+        let honest = t_fresh * tt as f64;
+        let bt = t_fresh + t_prep_targeted + upd;
+        let bf = t_fresh + t_prep_full + upd;
+        writeln!(f, "{circuit},{n},{nv},{tt},{t_setup:.3},{t_uk:.3},{t_fresh:.4},{t_prep_targeted:.4},{t_prep_full:.4},{:.4},{honest:.4},{bt:.4},{bf:.4},{:.3},{:.3}", t_update_avg * 1e3, honest / bt, honest / bf).unwrap();
+        eprintln!("T={tt:4}: honest {honest:8.2}s  batch(targeted) {bt:8.2}s  ratio {:6.2}   batch(full) {bf:8.2}s  ratio {:6.2}", honest / bt, honest / bf);
+    }
+    Ok(())
+}
