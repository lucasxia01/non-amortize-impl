index 0000000..7b01e72
--- /dev/null
+++ b/ark-groth16/examples/common/mod.rs
@@ -0,0 +1,86 @@
+//! Circuits shared by the Dynark examples: SHA-256 preimage knowledge and Dynark's synthetic
+//! R1CS, both with the tag as public input #1 bound by `tag * 0 = 0`.
+#![allow(dead_code)]
+use ark_bls12_381::Bls12_381;
+use ark_crypto_primitives::crh::{sha256::constraints::{Sha256Gadget, UnitVar}, CRHSchemeGadget};
+use ark_ec::pairing::Pairing;
+use ark_ff::{PrimeField, UniformRand, Zero};
+use ark_r1cs_std::prelude::*;
+use ark_relations::{lc, r1cs::{ConstraintMatrices, ConstraintSystem, ConstraintSystemRef, Matrix, OptimizationGoal, Variable}};
+use rand_chacha::ChaCha20Rng;
+use sha2::{Digest, Sha256};
+
+pub type E = Bls12_381;
+pub type F = <E as Pairing>::ScalarField;
+pub const TAG_VAR: usize = 1; // instance index of the tag (index 0 is the constant 1)
+
+pub fn env<T: std::str::FromStr>(k: &str, d: T) -> T { std::env::var(k).ok().and_then(|v| v.parse().ok()).unwrap_or(d) }
+
+/// Pad the constraint list so the domain (next power of two) is >= number of variables
+/// (Dynark's updating key indexes per-variable column lists by domain size).
+pub fn pad(m: &mut ConstraintMatrices<F>) {
+    let vars = m.num_instance_variables + m.num_witness_variables;
+    let target = m.num_constraints.max(vars).next_power_of_two();
+    while m.a.len() < target { m.a.push(vec![]); m.b.push(vec![]); m.c.push(vec![]); }
+    m.num_constraints = target;
+}
+
+/// tag * 0 = 0 as an extra row; returns the row index.
+pub fn add_tag_row(m: &mut ConstraintMatrices<F>) -> usize {
+    m.a.push(vec![(F::from(1u64), TAG_VAR)]); m.b.push(vec![]); m.c.push(vec![]);
+    m.a_num_non_zero += 1; m.num_constraints += 1;
+    m.num_constraints - 1
+}
+
+/// SHA-256 preimage knowledge (preimage and digest as witnesses, as in Dynark's example), with
+/// the tag allocated as the first public input. Returns (matrices, instance, witness, tag_row).
+pub fn sha256_circuit(blocks: usize, tag: F) -> (ConstraintMatrices<F>, Vec<F>, Vec<F>, usize) {
+    let preimage: Vec<u8> = (0..blocks * 64 - 9).map(|i| (i * 7 + 3) as u8).collect();
+    let digest = Sha256::digest(&preimage).to_vec();
+    let cs: ConstraintSystemRef<F> = ConstraintSystem::new_ref();
+    cs.set_optimization_goal(OptimizationGoal::Constraints);
+    let tag_var = cs.new_input_variable(|| Ok(tag)).unwrap();
+    let pre = UInt8::new_witness_vec(cs.clone(), &preimage).unwrap();
+    let dig = UInt8::new_witness_vec(cs.clone(), &digest).unwrap();
+    let computed = Sha256Gadget::<F>::evaluate(&UnitVar::default(), &pre).unwrap();
+    for (c, d) in computed.0.iter().zip(dig.iter()) { c.enforce_equal(d).unwrap(); }
+    // binding constraint: tag * 0 = 0
+    cs.enforce_constraint(lc!() + tag_var, lc!(), lc!()).unwrap();
+    cs.finalize();
+    assert!(cs.is_satisfied().unwrap());
+    let mut m = cs.to_matrices().unwrap();
+    let instance = cs.borrow().unwrap().instance_assignment.clone();
+    let witness = cs.borrow().unwrap().witness_assignment.clone();
+    // locate the tag row: the last constraint with a single A entry on TAG_VAR and empty B, C
+    let tag_row = (0..m.num_constraints).rev().find(|&i| m.a[i] == vec![(F::from(1u64), TAG_VAR)] && m.b[i].is_empty() && m.c[i].is_empty()).expect("tag row");
+    let _ = Variable::One;
+    pad(&mut m);
+    (m, instance, witness, tag_row)
+}
+
+/// Dynark's synthetic R1CS (rows `(k_a z_i + c_a)(k_b z_i + c_b) = z_{i+m}`) with the tag as
+/// instance #1 and one binding row. n = 2^log_n constraints.
+pub fn synthetic_circuit(log_n: usize, tag: F, rng: &mut ChaCha20Rng) -> (ConstraintMatrices<F>, Vec<F>, Vec<F>, usize) {
+    let n = 1usize << log_n;
+    let m = n / 2;
+    // variables: 0 = one, 1 = tag, then witness z_2 .. : we use (m-1) "x" values and (m-1) outputs
+    let num_instance = 2;
+    let num_witness = 2 * (m - 1);
+    let mut a: Matrix<F> = vec![vec![]; n]; let mut b = a.clone(); let mut c = a.clone();
+    let mut witness = vec![F::zero(); num_witness];
+    for i in 0..m - 1 {
+        let (ka, kb, ca, cb) = (F::rand(rng), F::rand(rng), F::rand(rng), F::rand(rng));
+        let x = F::rand(rng);
+        let xi = 2 + i; let yi = 2 + (m - 1) + i; // assignment indices
+        witness[xi - 2] = x; witness[yi - 2] = (x * ka + ca) * (x * kb + cb);
+        a[i] = vec![(ka, xi), (ca, 0)]; b[i] = vec![(kb, xi), (cb, 0)]; c[i] = vec![(F::from(1u64), yi)];
+    }
+    let mut mats = ConstraintMatrices { num_instance_variables: num_instance, num_witness_variables: num_witness, num_constraints: n, a_num_non_zero: 2 * (m - 1), b_num_non_zero: 2 * (m - 1), c_num_non_zero: m - 1, a, b, c };
+    // reuse the last (empty) row as the tag row
+    let tag_row = n - 1;
+    mats.a[tag_row] = vec![(F::from(1u64), TAG_VAR)]; mats.a_num_non_zero += 1;
+    (mats, vec![F::from(1u64), tag], witness, tag_row)
+}
+
+pub fn tag_of(i: u64) -> F { F::from_le_bytes_mod_order(&Sha256::digest(format!("tag-{i}")).to_vec()) }
+
