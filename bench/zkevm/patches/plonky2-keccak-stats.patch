+/// Instrumentation: per-thread timing and counting of every Keccak hash call made through this
+/// hasher (Merkle leaves, Merkle nodes, challenger permutation), flushed to global counters.
+pub mod keccak_stats {
+    //! Roles by call site: `hash_no_pad` = Merkle leaf (a table row), `two_to_one` = Merkle
+    //! node compression, `permute` = challenger permutation (also used by PoW grinding).
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    pub const ROLES: usize = 3;
+    pub const ROLE_NAMES: [&str; ROLES] = ["leaf", "node", "perm"];
+    pub static CALLS: [AtomicU64; ROLES] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+    pub static NS: [AtomicU64; ROLES] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+    pub static BYTES: [AtomicU64; ROLES] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+    #[derive(Clone, Copy, Debug, Default)]
+    pub struct Local { calls: [u64; ROLES], ns: [u64; ROLES], bytes: [u64; ROLES], pending: u64 }
+    std::thread_local! { static LOCAL: core::cell::Cell<Local> = const { core::cell::Cell::new(Local { calls: [0; 3], ns: [0; 3], bytes: [0; 3], pending: 0 }) }; }
+    pub const LEAF: usize = 0; pub const NODE: usize = 1; pub const PERM: usize = 2;
+    #[derive(Debug)]
+    pub struct HashTimer { t: std::time::Instant, bytes: u64, role: usize }
+    impl HashTimer {
+        #[inline] pub fn start(role: usize, bytes: usize) -> Self { Self { t: std::time::Instant::now(), bytes: bytes as u64, role } }
+    }
+    impl Drop for HashTimer {
+        #[inline] fn drop(&mut self) {
+            let ns = self.t.elapsed().as_nanos() as u64; let r = self.role;
+            LOCAL.with(|c| {
+                let mut l = c.get(); l.calls[r] += 1; l.ns[r] += ns; l.bytes[r] += self.bytes; l.pending += 1;
+                if l.pending >= 512 { publish(&l); l = Local::default(); }
+                c.set(l);
+            });
+        }
+    }
+    fn publish(l: &Local) { for r in 0..ROLES { CALLS[r].fetch_add(l.calls[r], Relaxed); NS[r].fetch_add(l.ns[r], Relaxed); BYTES[r].fetch_add(l.bytes[r], Relaxed); } }
+    /// Flush this thread's local counters.
+    pub fn flush_local() { LOCAL.with(|c| { publish(&c.get()); c.set(Local::default()); }); }
+    /// Snapshot: per-role (calls, nanoseconds, bytes).
+    #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+    pub struct Snapshot { pub calls: [u64; ROLES], pub ns: [u64; ROLES], pub bytes: [u64; ROLES] }
+    pub fn snapshot() -> Snapshot { flush_local(); let mut s = Snapshot::default(); for r in 0..ROLES { s.calls[r] = CALLS[r].load(Relaxed); s.ns[r] = NS[r].load(Relaxed); s.bytes[r] = BYTES[r].load(Relaxed); } s }
+    impl Snapshot {
+        pub fn diff(&self, earlier: &Snapshot) -> Snapshot { let mut d = Snapshot::default(); for r in 0..ROLES { d.calls[r] = self.calls[r] - earlier.calls[r]; d.ns[r] = self.ns[r] - earlier.ns[r]; d.bytes[r] = self.bytes[r] - earlier.bytes[r]; } d }
+        pub fn total_ns(&self) -> u64 { self.ns.iter().sum() }
+        pub fn total_calls(&self) -> u64 { self.calls.iter().sum() }
+        /// One-line machine-readable rendering: `leaf=calls/ns/bytes node=... perm=...`.
+        pub fn render(&self) -> String { (0..ROLES).map(|r| format!("{}={}/{}/{}", ROLE_NAMES[r], self.calls[r], self.ns[r], self.bytes[r])).collect::<Vec<_>>().join(" ") }
+    }
+    /// Print a `KECCAK_PHASE` line for the work between `earlier` and now.
+    pub fn report_phase(name: &str, earlier: &Snapshot) -> Snapshot { let now = snapshot(); let d = now.diff(earlier); eprintln!("KECCAK_PHASE: {name} {}", d.render()); now }
+}
